{
  "name": "opencode-task-aware-approvals",
  "version": "0.8.0-taskaware.1",
  "description": "Task-aware on-ask approvals for OpenCode V2 with build-bound reviewer qualification",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "permission",
    "auto-approval",
    "typescript"
  ],
  "homepage": "https://github.com/YiftahCooper/opencode-task-aware-approvals#readme",
  "bugs": {
    "url": "https://github.com/YiftahCooper/opencode-task-aware-approvals/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YiftahCooper/opencode-task-aware-approvals.git"
  },
  "license": "MIT",
  "author": "dyoshikawa",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/task-aware.d.ts",
        "default": "./dist/task-aware.js"
      },
      "require": {
        "types": "./dist/task-aware.d.cts",
        "default": "./dist/task-aware.cjs"
      }
    },
    "./legacy": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/task-aware.cjs",
  "module": "dist/task-aware.js",
  "types": "dist/task-aware.d.ts",
  "files": [
    "dist",
    "server.js",
    "scripts/manage.mjs",
    "scripts/artifact.mjs",
    "README.md",
    "TASK-AWARE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-id.mjs && tsdown && node scripts/stamp-build.mjs",
    "check": "corepack pnpm@10.30.3 run fmt:check && corepack pnpm@10.30.3 run oxlint && corepack pnpm@10.30.3 run typecheck",
    "cicheck": "corepack pnpm@10.30.3 run cicheck:code && corepack pnpm@10.30.3 run cicheck:content",
    "cicheck:code": "corepack pnpm@10.30.3 run check && corepack pnpm@10.30.3 run test",
    "cicheck:content": "corepack pnpm@10.30.3 run cspell && corepack pnpm@10.30.3 run secretlint",
    "cspell": "cspell --no-progress --gitignore .",
    "fix": "corepack pnpm@10.30.3 run fmt && corepack pnpm@10.30.3 run oxlint:fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "generate": "rulesync generate",
    "knip": "knip",
    "oxlint": "oxlint . --max-warnings 0",
    "oxlint:fix": "oxlint . --fix --max-warnings 0",
    "secretlint": "secretlint --secretlintignore .gitignore \"**/*\"",
    "sort": "sort-package-json",
    "test": "vitest run --silent=true",
    "test:coverage": "vitest run --coverage --silent=true",
    "test:watch": "vitest --silent=true",
    "typecheck": "tsc --noEmit",
    "test:distribution": "node --test tests/install.test.mjs tests/distribution.test.mjs",
    "package:release": "node scripts/package.mjs"
  },
  "dependencies": {
    "zod": "4.6.7",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.0",
    "@opencode/plugin": "2.0.28",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "cspell": "10.3.6",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "rulesync": "33.0.0",
    "secretlint": "13.0.7",
    "simple-git-hooks": "2.14.0",
    "sort-package-json": "4.0.0",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.29 <2",
    "@opencode/plugin": ">=2.0.0 <3"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  },
  "contributors": [
    "YiftahCooper"
  ],
  "packageManager": "pnpm@10.30.3"
}
